# --- Reference voice recordings -------------------------------------------
# Never commit these. A reference clip is a real person's voice and is very
# often cut from a commercial recording. Publishing one distributes both the
# copyrighted audio and that person's voiceprint.
hlasy/
voices/
*.wav
*.mp3
*.flac
*.m4a
*.m4b
*.ogg

